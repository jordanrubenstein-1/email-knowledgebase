# Streamlit Cloud secrets — enter these values in the Streamlit Cloud UI
# (Settings > Secrets). Do NOT commit this file with real credentials.
#
# Copy the block below into the Streamlit Cloud secrets editor:

[snowflake]
account   = "your-account-identifier"   # e.g. "abc12345.us-east-1"
user      = "your-snowflake-username"
password  = "your-snowflake-password"
database  = "AIRBYTE_DATABASE"
schema    = "LANDING_THE_INSIDE_GA4"
warehouse = "your-warehouse"            # optional
role      = "your-role"                 # optional
