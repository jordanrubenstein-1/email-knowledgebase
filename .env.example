# Copy this file to .env and fill in your values
# Never commit .env to version control

# Braze API Keys (per brand)
# Get from: Braze Dashboard > Settings > API Keys
# Format: BRAZE_API_KEY_{BRAND} and BRAZE_BASE_URL_{BRAND}

# Interior Define
BRAZE_API_KEY_ID=your-id-api-key
BRAZE_BASE_URL_ID=https://rest.iad-07.braze.com

# The Inside
BRAZE_API_KEY_TI=your-ti-api-key
BRAZE_BASE_URL_TI=https://rest.iad-07.braze.com

# The Citizenry
BRAZE_API_KEY_CZ=your-cz-api-key
BRAZE_BASE_URL_CZ=https://rest.iad-07.braze.com

# Havenly
BRAZE_API_KEY_HAV=your-hav-api-key
BRAZE_BASE_URL_HAV=https://rest.iad-07.braze.com

# Burrow
BRAZE_API_KEY_BUR=your-bur-api-key
BRAZE_BASE_URL_BUR=https://rest.iad-07.braze.com

# St. Frank
BRAZE_API_KEY_STF=your-stf-api-key
BRAZE_BASE_URL_STF=https://rest.iad-07.braze.com

# Fallback (used if brand-specific key not found)
BRAZE_API_KEY=your-default-api-key
BRAZE_BASE_URL=https://rest.iad-07.braze.com

# Asana Personal Access Token
# Get from: https://app.asana.com/0/my-apps
ASANA_ACCESS_TOKEN=your-asana-token-here

# Klaviyo API Keys (TI + TE brands)
# Get from: Klaviyo Account > Settings > API Keys > Create Private API Key
KLAVIYO_API_KEY_TI=your-ti-klaviyo-api-key
KLAVIYO_API_KEY_TE=your-te-klaviyo-api-key

# HubSpot API Key (TE brand — trade program contacts/companies)
# Get from: HubSpot Account > Settings > Integrations > Private Apps
HUBSPOT_API_KEY_TE=your-te-hubspot-api-key

# Braze Dashboard Automation (Playwright)
# Used for browser-based automation of Braze dashboard
BRAZE_DASHBOARD_URL=https://dashboard-07.braze.com
BRAZE_DASHBOARD_EMAIL=your-braze-email@example.com
BRAZE_DASHBOARD_PASSWORD=your-braze-password

# TOTP Secret for MFA (required if 2FA is enabled)
# Extract from 2FA setup: look for "enter this text code" option, or
# decode the QR code URL (otpauth://totp/...?secret=THIS_VALUE&...)
BRAZE_TOTP_SECRET=your-base32-totp-secret

# Google Sheets API
# Get from: https://console.cloud.google.com/apis/credentials
# Required for sale schedule sync and calendar task import
GOOGLE_SHEETS_API_KEY=your-google-sheets-api-key

# Promo Calendar Google Sheet ID
# Extracted from: https://docs.google.com/spreadsheets/d/{THIS_ID}/edit
PROMO_CALENDAR_SHEET_ID=1-oyVfD7ZpYOoeVnKNFVMAc9wAeiiF-J3jmRbl3qzx5c

# Slack Incoming Webhook (used by scripts/utils/slack_client.py)
# Create at: https://api.slack.com/apps > Incoming Webhooks > Add New Webhook to Workspace
# Bound to a single pre-selected channel (#team-lifecycle) at creation time.
SLACK_WEBHOOK_URL_TEAM_LIFECYCLE=https://hooks.slack.com/services/your/webhook/url

# Air (asset management) API Key
# Get from: Air Workspace Settings > API Access (Business/Enterprise plans)
AIR_API_KEY=your-air-api-key
AIR_WORKSPACE_ID=your-air-workspace-id

# Snowflake Connection (for GA4 data via Airbyte)
SNOWFLAKE_ACCOUNT=PLUSLPI-IR59309
SNOWFLAKE_USER=JRUBENSTEIN
# Use either password OR authenticator (externalbrowser for SSO)
SNOWFLAKE_PASSWORD=your_password_here
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ROLE=MCP_READER
# Warehouse is optional - leave empty if not needed
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=AIRBYTE_DATABASE

# Brand-specific schemas (automatically mapped)
# BUR -> LANDING_BURROW_GA4
# CZ -> LANDING_CITIZENRY_GA4
# ID -> LANDING_INTERIORDEFINE_GA4

# GA4 Table: TRAFFIC_SESSION_PERFORMANCE_DAILY
# Column mappings for this table:
SNOWFLAKE_GA4_TABLE=TRAFFIC_SESSION_PERFORMANCE_DAILY
SNOWFLAKE_CAMPAIGN_DIMENSION=SESSIONCAMPAIGNNAME
SNOWFLAKE_DATE_COLUMN=DATE
SNOWFLAKE_DATE_FORMAT=YYYYMMDD
SNOWFLAKE_SESSIONS_COLUMN=SESSIONS
SNOWFLAKE_PURCHASES_COLUMN=ECOMMERCEPURCHASES
SNOWFLAKE_REVENUE_COLUMN=TOTALREVENUE
# Email vs SMS: use channel group (matches GA4 UI). Default SESSIONPRIMARYCHANNELGROUP.
# Override per brand: SNOWFLAKE_CHANNEL_GROUP_COLUMN_BUR, etc.
SNOWFLAKE_CHANNEL_GROUP_COLUMN=SESSIONPRIMARYCHANNELGROUP

# ---------------------------------------------------------------------------
# Inventory Data Sources (used by scripts/utils/inventory_checker.py)
# ---------------------------------------------------------------------------
# Product inventory is queried to inject in-stock products into AI-generated
# email creative direction. No extra env vars needed — sources are hardcoded:
#
# Shopify (FIVETRAN_DB) — customer-facing inventory, daily sync:
#   BUR -> FIVETRAN_DB.LANDING_BURROW_SHOPIFY   (PRODUCT, PRODUCT_VARIANT)
#   CZ  -> FIVETRAN_DB.LANDING_CZ_SHOPIFY       (PRODUCT, PRODUCT_VARIANT)
#   STF -> FIVETRAN_DB.LANDING_STF_SHOPIFY       (PRODUCT, PRODUCT_VARIANT)
#
# Havenly Products (AIRBYTE_DATABASE) — boolean availability, daily sync:
#   HAV -> AIRBYTE_DATABASE.LANDING_HAVENLY_PRODUCTS (AVAILABILITIES, VENDOR_VARIANTS)
#
# Not supported: ID (Fivetran data stale since Nov 2025), TI (no data)
#
# Note: Fivetran is being migrated to Airbyte. When Shopify data moves to
# AIRBYTE_DATABASE, update the database/schema mappings in inventory_checker.py.
