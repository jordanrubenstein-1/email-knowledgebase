{% comment %}
  Hero Image Component

  Creates a full-width linked image for email headers/hero sections.

  Required variables:
    image     - URL of the hero image
    link      - URL for the image link

  Optional variables:
    alt            - Alt text for image (default: '')
    title          - Title attribute for image (default: same as alt)
    container_width - Container width in pixels (default: 600)

  Usage:
    {% assign image = 'https://...' %}
    {% assign link = 'https://...' %}
    {% assign alt = 'Hero Image Description' %}
    {% render 'hero_image' %}
{% endcomment %}

{% assign container_width = container_width | default: 600 %}
{% assign alt = alt | default: '' %}
{% assign title = title | default: alt %}

<table class="image_block" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="mso-table-lspace:0;mso-table-rspace:0"><tr><td class="pad" style="width:100%"><div class="alignment" align="center"><div style="max-width:{{ container_width }}px"><a href="{{ link }}" target="_blank" style="outline:none" tabindex="-1"><img src="{{ image }}" style="display:block;height:auto;border:0;width:100%" width="{{ container_width }}" alt="{{ alt }}" title="{{ title }}" height="auto"></a></div></div></td></tr></table>
