{% if cat_preset == "default_light" %}
  {% assign cat_bg = "#f7eee3" %}
  {% assign cat_text = "#101b24" %}
  {% assign cat_btn_bg = "#101b24" %}
  {% assign cat_btn_text = "#ffffff" %}
{% elsif cat_preset == "default_dark" %}
  {% assign cat_bg = "#101b24" %}
  {% assign cat_text = "#ffffff" %}
  {% assign cat_btn_bg = "#f7eee3" %}
  {% assign cat_btn_text = "#101b24" %}
{% elsif cat_preset == "white" %}
  {% assign cat_bg = "#fffffe" %}
  {% assign cat_text = "#101b24" %}
  {% assign cat_btn_bg = "#101b24" %}
  {% assign cat_btn_text = "#ffffff" %}
{% elsif cat_preset == "cream" %}
  {% assign cat_bg = "#f7eee3" %}
  {% assign cat_text = "#101b24" %}
  {% assign cat_btn_bg = "#101b24" %}
  {% assign cat_btn_text = "#ffffff" %}
{% elsif cat_preset == "warm_brown" %}
  {% assign cat_bg = "#f7eee3" %}
  {% assign cat_text = "#101b24" %}
  {% assign cat_btn_bg = "#7a4535" %}
  {% assign cat_btn_text = "#ffffff" %}
{% endif %}

