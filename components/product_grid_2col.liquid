{% comment %}
  Product Grid 2-Column Component

  Creates a responsive 2-column product image grid for email templates.
  Each column contains a linked product image.

  Required variables:
    left_image  - URL of left product image
    left_link   - URL for left product link
    right_image - URL of right product image
    right_link  - URL for right product link

  Optional variables:
    left_alt     - Alt text for left image (default: '')
    right_alt    - Alt text for right image (default: '')
    left_title   - Title attribute for left image (default: same as left_alt)
    right_title  - Title attribute for right image (default: same as right_alt)
    container_width - Container width in pixels (default: 600)

  Usage:
    {% assign left_image = 'https://...' %}
    {% assign left_link = 'https://...' %}
    {% assign right_image = 'https://...' %}
    {% assign right_link = 'https://...' %}
    {% assign left_alt = 'Product Name' %}
    {% assign right_alt = 'Product Name' %}
    {% render 'product_grid_2col' %}
{% endcomment %}

{% assign container_width = container_width | default: 600 %}
{% assign column_width = container_width | divided_by: 2 %}
{% assign left_alt = left_alt | default: '' %}
{% assign right_alt = right_alt | default: '' %}
{% assign left_title = left_title | default: left_alt %}
{% assign right_title = right_title | default: right_alt %}

<table class="row-content" align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="mso-table-lspace:0;mso-table-rspace:0;background-color:#fff;border-radius:0;color:#000;width:{{ container_width }}px;margin:0 auto" width="{{ container_width }}"><tbody><tr><td class="column column-1" width="50%" style="mso-table-lspace:0;mso-table-rspace:0;font-weight:400;text-align:left;vertical-align:top"><table class="image_block block-1" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="mso-table-lspace:0;mso-table-rspace:0"><tr><td class="pad" style="width:100%"><div class="alignment" align="center"><div style="max-width:{{ column_width }}px"><a href="{{ left_link }}" target="_blank" style="outline:none" tabindex="-1"><img src="{{ left_image }}" style="display:block;height:auto;border:0;width:100%" width="{{ column_width }}" alt="{{ left_alt }}" title="{{ left_title }}" height="auto"></a></div></div></td></tr></table></td><td class="column column-2" width="50%" style="mso-table-lspace:0;mso-table-rspace:0;font-weight:400;text-align:left;vertical-align:top"><table class="image_block block-1" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="mso-table-lspace:0;mso-table-rspace:0"><tr><td class="pad" style="width:100%"><div class="alignment" align="center"><div style="max-width:{{ column_width }}px"><a href="{{ right_link }}" target="_blank" style="outline:none" tabindex="-1"><img src="{{ right_image }}" style="display:block;height:auto;border:0;width:100%" width="{{ column_width }}" alt="{{ right_alt }}" title="{{ right_title }}" height="auto"></a></div></div></td></tr></table></td></tr></tbody></table>
