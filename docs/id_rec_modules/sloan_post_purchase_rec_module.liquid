<!-- sloan_post_purchase_rec_module.liquid
     Dynamic cross-sell block for Sloan post-purchase canvas.

     How it works:
       1. Reads canvas_entry_properties.products[0].sku + .variant from the
          Purchase event (no custom attributes or engineering writes needed)
       2. Parses the fabric code and leg code from the variant string
       3. Applies per-slot fallbacks for fabrics/legs not available on each product
       4. Constructs Cylindo image URLs and interiordefine.com PDP links
       5. Assigns template variables used by the HTML layout below

     Slot layout:
       Slot 1 — Sloan Sleeper      (SLON.FABRIC.SOFA.SLEEPR)
       Slot 2 — Sloan Leather      (SLON.LEATHR.SOFA.STNDRD)
       Slot 3 — Sloan Ottoman      (SLON.FABRIC.OTTO.STNDRD)
       Slot 4 — Sloan Chaise       (SLON.FABRIC.CHSE.CHAISE)

     Fallback rules:
       Sleeper — all 122 source fabrics available; no fabric fallback needed
                 only has 4 legs (LEG001-1, LEG007-1/2/3) → mapped by finish family
       Leather — always 2210A (Palomino); LEG016-2 not in feed → LEG001-2
       Ottoman — full fabric + leg coverage; no fallback needed
       Chaise  — 5 fabrics not carried (HS-002, WH-001, WH-003–005) → MER-002; full leg coverage

     Only renders for SLON purchases. Other collections (MXWL, JAMES) are no-ops
     until their modules are built.
-->

{% assign sku     = canvas_entry_properties.${products}[0].sku     | default: "" %}
{% assign variant = canvas_entry_properties.${products}[0].variant | default: "" %}

{% comment %}--- Parse fabric code and leg code from variant string ---{% endcomment %}
{% comment %}
  Variant format: {BASE_SKU}-{FABRIC_PT1}-{FABRIC_PT2}-{OTHER_OPTIONS}
  e.g. SLON.FABRIC.SOFA.3SEAT-MER-005-DEPTH-40-Leg001-3-LENGTH-95-DAR-10
  color = first two hyphen tokens after base SKU  → MER-005
  legs  = token containing "Leg" + the next token → Leg001-3 (upcased → LEG001-3)
{% endcomment %}
{% assign sku_parts    = sku | split: "." %}
{% assign col          = sku_parts[0] %}
{% assign options_str  = variant | remove_first: sku | remove_first: "-" %}
{% assign option_parts = options_str | split: "-" %}
{% assign color        = option_parts[0] | append: "-" | append: option_parts[1] %}

{% assign legs = "" %}
{% for i in (0..15) %}
  {% assign _part = option_parts[i] %}
  {% if _part contains "Leg" and legs == "" %}
    {% assign _next = i | plus: 1 %}
    {% assign legs = _part | append: "-" | append: option_parts[_next] | upcase %}
  {% endif %}
{% endfor %}
{% if legs == "" %}{% assign legs = "LEG001-1" %}{% endif %}

{% comment %}3-part fabric codes: OTE-SUNDAY-103, AK-618-xx, I-73338-xx — append the third token{% endcomment %}
{% if option_parts[0] == "OTE" or option_parts[0] == "AK" or option_parts[0] == "I" %}
  {% assign color = option_parts[0] | append: "-" | append: option_parts[1] | append: "-" | append: option_parts[2] %}
{% endif %}

{% if col == "SLON" %}

  {% comment %}--- Slot 1: Sleeper leg mapping ---{% endcomment %}
  {% comment %}
    Cylindo only has LEG007-1/2/3 for the Sleeper (LEG001-1 is in the feed but 404 in Cylindo).
    Map all 18 sofa legs to the closest Sleeper L Leg by finish family:
      Oiled Walnut (LEG001-1, LEG002-4, LEG014-3, LEG016-1) → LEG007-1
      Painted/Matte Black + Gunmetal (LEG001-3, LEG002-3, LEG008-2, LEG014-2, LEG016-3, LEG009-3) → LEG007-3
      Everything else (Natural Oak, chrome, brass, nickel) → LEG007-2
  {% endcomment %}
  {% if legs == "LEG001-1" or legs == "LEG002-4" or legs == "LEG014-3" or legs == "LEG016-1" %}
    {% assign sleeper_leg = "LEG007-1" %}
  {% elsif legs == "LEG001-3" or legs == "LEG002-3" or legs == "LEG008-2" or legs == "LEG014-2" or legs == "LEG016-3" or legs == "LEG009-3" %}
    {% assign sleeper_leg = "LEG007-3" %}
  {% else %}
    {% assign sleeper_leg = "LEG007-2" %}
  {% endif %}

  {% comment %}--- Slot 1: Sleeper fabric fallback ---{% endcomment %}
  {% comment %}
    Magento confirmed: all 122 source sofa fabrics are available on the Sleeper.
    No fallback needed — always use buyer's fabric directly.
  {% endcomment %}
  {% assign sleeper_fabric = color %}

  {% comment %}--- Slot 2: Leather always Palomino; LEG016-2 → LEG001-2 ---{% endcomment %}
  {% if legs == "LEG016-2" %}
    {% assign leather_leg = "LEG001-2" %}
  {% else %}
    {% assign leather_leg = legs %}
  {% endif %}

  {% comment %}--- Slot 4: Chaise fabric fallback → Limestone (MER-002) ---{% endcomment %}
  {% comment %}
    Not available on Chaise: HS-002, WH-001, WH-003, WH-004, WH-005 (~0.6% of sofa buyers)
    (WH-002 was added to Chaise; WH-001 and WH-005 are new gaps vs prior order-data list)
  {% endcomment %}
  {% if color == "HS-002" or color == "WH-001" or color == "WH-003" or color == "WH-004" or color == "WH-005" %}
    {% assign chaise_fabric = "MER-002" %}
  {% else %}
    {% assign chaise_fabric = color %}
  {% endif %}

  {% comment %}--- Cylindo image URLs ---{% endcomment %}
  {% assign _cyl = "https://content.cylindo.com/api/v2/4472/products/" %}

  {% assign img_sleeper = _cyl | append: "SLON.FABRIC.SOFA.SLEEPR/frames/1/SLON.FABRIC.SOFA.SLEEPR.png?background=FFFFFF&feature=COLOR:" | append: sleeper_fabric | append: "&feature=CUSHIONS:CUSHION-2&feature=FINISH:" | append: sleeper_leg %}

  {% assign img_leather = _cyl | append: "SLON.LEATHR.SOFA.STNDRD/frames/1/SLON.LEATHR.SOFA.STNDRD.png?background=FFFFFF&feature=COLOR:2210A&feature=DEPTH:DEPTH-36&feature=FINISH:" | append: leather_leg | append: "&feature=CUSHIONS:CUSHION-2" %}

  {% assign img_ottoman = _cyl | append: "SLON.FABRIC.OTTO.STNDRD/frames/1/SLON.FABRIC.OTTO.STNDRD.png?background=FFFFFF&feature=FINISH:" | append: legs | append: "&feature=COLOR:" | append: color %}

  {% assign img_chaise = _cyl | append: "SLON.FABRIC.CHSE.CHAISE/frames/1/SLON.FABRIC.CHSE.CHAISE.png?background=FFFFFF&feature=COLOR:" | append: chaise_fabric | append: "&feature=CHAISE%20LENGTH:CHAISE-63&feature=FINISH:" | append: legs %}

  {% comment %}--- PDP links — catalog-driven, pre-selects buyer's fabric + leg ---{% endcomment %}

  {% comment %}Sleeper{% endcomment %}
  {% catalog_items product_config SLON_SLEEPR %}{% assign _sleepr_prod = catalog_items[0] %}
  {% catalog_items fabric_ids {{ "SLON_SLEEPR_" | append: sleeper_fabric }} %}{% assign _sleepr_fab = catalog_items[0] %}
  {% catalog_items leg_ids {{ "SLON_SLEEPR_" | append: sleeper_leg }} %}{% assign _sleepr_leg = catalog_items[0] %}
  {% if _sleepr_fab.material_type_id and _sleepr_leg.legs_type_id %}
    {% assign url_sleeper = _sleepr_prod.base_url
      | append: "?legs-type=" | append: _sleepr_leg.legs_type_id
      | append: "&material-type=" | append: _sleepr_fab.material_type_id
      | append: "&options-" | append: _sleepr_prod.fabric_attr_id | append: "=" | append: _sleepr_fab.material_type_id
      | append: "&options-" | append: _sleepr_prod.leg_attr_id | append: "=" | append: _sleepr_leg.legs_type_id
      | append: "&" | append: _sleepr_prod.fixed_params %}
  {% else %}
    {% assign url_sleeper = _sleepr_prod.base_url %}
  {% endif %}

  {% comment %}Leather (always shows Palomino/2210A regardless of buyer's leather color){% endcomment %}
  {% catalog_items product_config SLON_LEATHR %}{% assign _leathr_prod = catalog_items[0] %}
  {% catalog_items fabric_ids SLON_LEATHR_2210A %}{% assign _leathr_fab = catalog_items[0] %}
  {% catalog_items leg_ids {{ "SLON_LEATHR_" | append: leather_leg }} %}{% assign _leathr_leg = catalog_items[0] %}
  {% if _leathr_fab.material_type_id and _leathr_leg.legs_type_id %}
    {% assign url_leather = _leathr_prod.base_url
      | append: "?legs-type=" | append: _leathr_leg.legs_type_id
      | append: "&material-type=" | append: _leathr_fab.material_type_id
      | append: "&options-" | append: _leathr_prod.fabric_attr_id | append: "=" | append: _leathr_fab.material_type_id
      | append: "&options-" | append: _leathr_prod.leg_attr_id | append: "=" | append: _leathr_leg.legs_type_id
      | append: "&" | append: _leathr_prod.fixed_params %}
  {% else %}
    {% assign url_leather = _leathr_prod.base_url %}
  {% endif %}

  {% comment %}Ottoman{% endcomment %}
  {% catalog_items product_config SLON_OTTO %}{% assign _otto_prod = catalog_items[0] %}
  {% catalog_items fabric_ids {{ "SLON_OTTO_" | append: color }} %}{% assign _otto_fab = catalog_items[0] %}
  {% catalog_items leg_ids {{ "SLON_OTTO_" | append: legs }} %}{% assign _otto_leg = catalog_items[0] %}
  {% if _otto_fab.material_type_id and _otto_leg.legs_type_id %}
    {% assign url_ottoman = _otto_prod.base_url
      | append: "?legs-type=" | append: _otto_leg.legs_type_id
      | append: "&material-type=" | append: _otto_fab.material_type_id
      | append: "&options-" | append: _otto_prod.fabric_attr_id | append: "=" | append: _otto_fab.material_type_id
      | append: "&options-" | append: _otto_prod.leg_attr_id | append: "=" | append: _otto_leg.legs_type_id
      | append: "&" | append: _otto_prod.fixed_params %}
  {% else %}
    {% assign url_ottoman = _otto_prod.base_url %}
  {% endif %}

  {% comment %}Chaise{% endcomment %}
  {% catalog_items product_config SLON_CHSE %}{% assign _chse_prod = catalog_items[0] %}
  {% catalog_items fabric_ids {{ "SLON_CHSE_" | append: chaise_fabric }} %}{% assign _chse_fab = catalog_items[0] %}
  {% catalog_items leg_ids {{ "SLON_CHSE_" | append: legs }} %}{% assign _chse_leg = catalog_items[0] %}
  {% if _chse_fab.material_type_id and _chse_leg.legs_type_id %}
    {% assign url_chaise = _chse_prod.base_url
      | append: "?legs-type=" | append: _chse_leg.legs_type_id
      | append: "&material-type=" | append: _chse_fab.material_type_id
      | append: "&options-" | append: _chse_prod.fabric_attr_id | append: "=" | append: _chse_fab.material_type_id
      | append: "&options-" | append: _chse_prod.leg_attr_id | append: "=" | append: _chse_leg.legs_type_id
      | append: "&" | append: _chse_prod.fixed_params %}
  {% else %}
    {% assign url_chaise = _chse_prod.base_url %}
  {% endif %}

{% endif %}

<!-- =====================================================================
     HTML LAYOUT — paste below into the email template after the block above
     Uses: img_sleeper, img_leather, img_ottoman, img_chaise
           url_sleeper, url_leather, url_ottoman, url_chaise
     Only renders when col == "SLON"
     ===================================================================== -->

{% if col == "SLON" %}
<table width="600" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial,sans-serif;font-size:14px;color:#101b24;">
  <tr>
    <td style="padding:24px 0 8px 0;text-align:center;font-size:18px;font-weight:bold;letter-spacing:0.02em;">
      Complete Your Sloan Collection
    </td>
  </tr>
  <!-- Row 1: Sleeper + Leather -->
  <tr>
    <td style="padding:0 0 12px 0;">
      <table width="600" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <!-- Slot 1: Sleeper -->
          <td width="294" style="padding-right:6px;vertical-align:top;text-align:center;">
            <a href="{{ url_sleeper }}" style="display:block;">
              <img src="{{ img_sleeper }}" width="294" alt="Sloan Sleeper Sofa" style="display:block;width:100%;border:0;" />
            </a>
            <p style="margin:6px 0 0 0;font-size:13px;color:#101b24;">Sloan Sleeper Sofa</p>
            <a href="{{ url_sleeper }}" style="font-size:12px;color:#1871D8;text-decoration:underline;">Shop Now</a>
          </td>
          <!-- Slot 2: Leather -->
          <td width="294" style="padding-left:6px;vertical-align:top;text-align:center;">
            <a href="{{ url_leather }}" style="display:block;">
              <img src="{{ img_leather }}" width="294" alt="Sloan Leather Sofa" style="display:block;width:100%;border:0;" />
            </a>
            <p style="margin:6px 0 0 0;font-size:13px;color:#101b24;">Sloan Leather Sofa</p>
            <a href="{{ url_leather }}" style="font-size:12px;color:#1871D8;text-decoration:underline;">Shop Now</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <!-- Row 2: Ottoman + Chaise -->
  <tr>
    <td style="padding:0 0 24px 0;">
      <table width="600" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <!-- Slot 3: Ottoman -->
          <td width="294" style="padding-right:6px;vertical-align:top;text-align:center;">
            <a href="{{ url_ottoman }}" style="display:block;">
              <img src="{{ img_ottoman }}" width="294" alt="Sloan Ottoman" style="display:block;width:100%;border:0;" />
            </a>
            <p style="margin:6px 0 0 0;font-size:13px;color:#101b24;">Sloan Ottoman</p>
            <a href="{{ url_ottoman }}" style="font-size:12px;color:#1871D8;text-decoration:underline;">Shop Now</a>
          </td>
          <!-- Slot 4: Chaise -->
          <td width="294" style="padding-left:6px;vertical-align:top;text-align:center;">
            <a href="{{ url_chaise }}" style="display:block;">
              <img src="{{ img_chaise }}" width="294" alt="Sloan Chaise Lounge" style="display:block;width:100%;border:0;" />
            </a>
            <p style="margin:6px 0 0 0;font-size:13px;color:#101b24;">Sloan Chaise Lounge</p>
            <a href="{{ url_chaise }}" style="font-size:12px;color:#1871D8;text-decoration:underline;">Shop Now</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
{% endif %}
