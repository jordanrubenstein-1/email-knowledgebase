<!-- swatch_color_rec_module.liquid
     Liquid personalization block for swatch post-purchase T1 (and T2) emails.

     How it works:
       1. Parses canvas_entry_properties.swatches (JSON array of swatch objects)
       2. Counts how many swatches belong to each color-family prefix (ROY, MER, etc.)
       3. Picks the most-frequent family as primary, second-most as secondary
       4. Includes the matching SwatchRec_* content block (generated by
          scripts/id_recommendation_blocks.py --swatch-color-blocks)
       5. Includes the secondary block if the order spans 2+ families

     Leather swatches (LTHR, 2210A) are excluded from family scoring.
     has_leather is available for conditional copy in the same template.

     Prerequisites:
       - SwatchRec_ROY, SwatchRec_MER, ..., SwatchRec_Default content blocks
         must exist in Braze (generate with --swatch-color-blocks)
       - canvas_entry_properties.swatches must be a JSON array string from
         the Swatch Order event (each element has a "sku" field)

     To insert in the T1 email: paste this block before the footer row.
-->

{% assign swatches = canvas_entry_properties.${swatches} | parse_json %}

{% assign count_ROY = 0 %}{% assign count_MER = 0 %}{% assign count_SE = 0 %}
{% assign count_COV = 0 %}{% assign count_AK = 0 %}{% assign count_HRT = 0 %}
{% assign count_GIA = 0 %}{% assign count_CAS = 0 %}{% assign count_AM = 0 %}
{% assign count_LNL = 0 %}{% assign count_PD = 0 %}{% assign count_SMA = 0 %}
{% assign has_leather = false %}

{% for swatch in swatches %}
  {% assign prefix = swatch.sku | split: "-" | first %}
  {% case prefix %}
    {% when "ROY" %}{% assign count_ROY = count_ROY | plus: 1 %}
    {% when "MER" %}{% assign count_MER = count_MER | plus: 1 %}
    {% when "SE"  %}{% assign count_SE  = count_SE  | plus: 1 %}
    {% when "COV" %}{% assign count_COV = count_COV | plus: 1 %}
    {% when "AK"  %}{% assign count_AK  = count_AK  | plus: 1 %}
    {% when "HRT" %}{% assign count_HRT = count_HRT | plus: 1 %}
    {% when "GIA" %}{% assign count_GIA = count_GIA | plus: 1 %}
    {% when "CAS" %}{% assign count_CAS = count_CAS | plus: 1 %}
    {% when "AM"  %}{% assign count_AM  = count_AM  | plus: 1 %}
    {% when "LNL" %}{% assign count_LNL = count_LNL | plus: 1 %}
    {% when "PD"  %}{% assign count_PD  = count_PD  | plus: 1 %}
    {% when "SMA" %}{% assign count_SMA = count_SMA | plus: 1 %}
    {% when "LTHR","2210A" %}{% assign has_leather = true %}
  {% endcase %}
{% endfor %}

{% assign best = 0 %}{% assign primary_fam = "Default" %}
{% if count_ROY > best %}{% assign best = count_ROY %}{% assign primary_fam = "ROY" %}{% endif %}
{% if count_MER > best %}{% assign best = count_MER %}{% assign primary_fam = "MER" %}{% endif %}
{% if count_SE  > best %}{% assign best = count_SE  %}{% assign primary_fam = "SE"  %}{% endif %}
{% if count_COV > best %}{% assign best = count_COV %}{% assign primary_fam = "COV" %}{% endif %}
{% if count_AK  > best %}{% assign best = count_AK  %}{% assign primary_fam = "AK"  %}{% endif %}
{% if count_HRT > best %}{% assign best = count_HRT %}{% assign primary_fam = "HRT" %}{% endif %}
{% if count_GIA > best %}{% assign best = count_GIA %}{% assign primary_fam = "GIA" %}{% endif %}
{% if count_CAS > best %}{% assign best = count_CAS %}{% assign primary_fam = "CAS" %}{% endif %}
{% if count_AM  > best %}{% assign best = count_AM  %}{% assign primary_fam = "AM"  %}{% endif %}
{% if count_LNL > best %}{% assign best = count_LNL %}{% assign primary_fam = "LNL" %}{% endif %}
{% if count_PD  > best %}{% assign best = count_PD  %}{% assign primary_fam = "PD"  %}{% endif %}
{% if count_SMA > best %}{% assign best = count_SMA %}{% assign primary_fam = "SMA" %}{% endif %}

{% assign second_best = 0 %}{% assign secondary_fam = "" %}
{% assign families = "ROY,MER,SE,COV,AK,HRT,GIA,CAS,AM,LNL,PD,SMA" | split: "," %}
{% for fam in families %}
  {% if fam != primary_fam %}
    {% assign fam_count = 0 %}
    {% if fam == "ROY" %}{% assign fam_count = count_ROY %}
    {% elsif fam == "MER" %}{% assign fam_count = count_MER %}
    {% elsif fam == "SE"  %}{% assign fam_count = count_SE  %}
    {% elsif fam == "COV" %}{% assign fam_count = count_COV %}
    {% elsif fam == "AK"  %}{% assign fam_count = count_AK  %}
    {% elsif fam == "HRT" %}{% assign fam_count = count_HRT %}
    {% elsif fam == "GIA" %}{% assign fam_count = count_GIA %}
    {% elsif fam == "CAS" %}{% assign fam_count = count_CAS %}
    {% elsif fam == "AM"  %}{% assign fam_count = count_AM  %}
    {% elsif fam == "LNL" %}{% assign fam_count = count_LNL %}
    {% elsif fam == "PD"  %}{% assign fam_count = count_PD  %}
    {% elsif fam == "SMA" %}{% assign fam_count = count_SMA %}{% endif %}
    {% if fam_count > second_best %}{% assign second_best = fam_count %}{% assign secondary_fam = fam %}{% endif %}
  {% endif %}
{% endfor %}

{% if primary_fam == "ROY" %}{{content_blocks.${SwatchRec_ROY}}}
{% elsif primary_fam == "MER" %}{{content_blocks.${SwatchRec_MER}}}
{% elsif primary_fam == "SE"  %}{{content_blocks.${SwatchRec_SE}}}
{% elsif primary_fam == "COV" %}{{content_blocks.${SwatchRec_COV}}}
{% elsif primary_fam == "AK"  %}{{content_blocks.${SwatchRec_AK}}}
{% elsif primary_fam == "HRT" %}{{content_blocks.${SwatchRec_HRT}}}
{% elsif primary_fam == "GIA" %}{{content_blocks.${SwatchRec_GIA}}}
{% elsif primary_fam == "CAS" %}{{content_blocks.${SwatchRec_CAS}}}
{% elsif primary_fam == "AM"  %}{{content_blocks.${SwatchRec_AM}}}
{% else %}{{content_blocks.${SwatchRec_Default}}}{% endif %}

{% if secondary_fam != "" and second_best > 0 %}
  {% if secondary_fam == "ROY" %}{{content_blocks.${SwatchRec_ROY}}}
  {% elsif secondary_fam == "MER" %}{{content_blocks.${SwatchRec_MER}}}
  {% elsif secondary_fam == "SE"  %}{{content_blocks.${SwatchRec_SE}}}
  {% elsif secondary_fam == "COV" %}{{content_blocks.${SwatchRec_COV}}}
  {% elsif secondary_fam == "AK"  %}{{content_blocks.${SwatchRec_AK}}}
  {% elsif secondary_fam == "HRT" %}{{content_blocks.${SwatchRec_HRT}}}
  {% elsif secondary_fam == "GIA" %}{{content_blocks.${SwatchRec_GIA}}}
  {% elsif secondary_fam == "CAS" %}{{content_blocks.${SwatchRec_CAS}}}
  {% elsif secondary_fam == "AM"  %}{{content_blocks.${SwatchRec_AM}}}{% endif %}
{% endif %}
