<!-- maxwell_post_purchase_rec_module.liquid
     Dynamic cross-sell block for Maxwell post-purchase canvas.

     How it works:
       Identical flow to sloan_post_purchase_rec_module.liquid —
       reads col/color/legs from canvas entry properties, applies
       per-slot fallbacks, constructs Cylindo image URLs + PDP links.

     Slot layout:
       Slot 1 — Maxwell Tall        (MXWL.FABRIC.SOFA.STNDRD.TALL)
       Slot 2 — Maxwell Slipcovered (MXWL.SLPCOV.SOFA.STNDRD) — fixed showcase CAS-016
       Slot 3 — Maxwell Leather     (MXWL.LEATHR.SOFA.STNDRD)  — fixed showcase 2210A (Palomino)
       Slot 4 — Maxwell Ottoman     (MXWL.FABRIC.OTTO.STNDRD)

     Fallback rules:
       Tall      — catalog sparse: only AK-618-16 fabric / Leg014-3 leg confirmed from
                   WEB_PAGES (all Google PMax landing pages use AK-618-16 as the default
                   sku; other fabric→material_type_id mappings are not extractable).
                   Catalog miss → base_url. Cylindo image always personalized with
                   buyer's actual fabric + leg regardless of catalog coverage.
       Slipcov   — buyer's standard Maxwell sofa fabric codes (ROY-x, SE-x, MER-x, etc.)
                   are NOT available on the Slipcovered product; it uses slipcover-specific
                   fabrics (CAS, COV, CU, BI). Always shows CAS-016 (Ivory Canvas) showcase.
                   Only Leg016-x is catalog-confirmed; Leg014-x (18% of Slipcov orders) and
                   Leg001-x fall back to LEG016-1.
       Leather   — always 2210A (Palomino). Leg002-3 not available on Maxwell Leather → LEG002-4.
       Ottoman   — 2 fabrics not on ottoman (ANG-003, OMNI-016) → MER-002; full leg coverage.

     Only renders for MXWL fabric-sofa buyers. Guard: col == "MXWL".

     Smoke-test before live: verify Cylindo URLs for Tall and Leather return valid images
     (Cylindo feature param names — e.g. CUSHIONS, DEPTH — may need adjustment per product).
-->

{% assign sku     = canvas_entry_properties.${products}[0].sku     | default: "" %}
{% assign variant = canvas_entry_properties.${products}[0].variant | default: "" %}

{% comment %}--- Parse fabric code and leg code from variant string ---{% endcomment %}
{% comment %}
  Variant format: {BASE_SKU}-{FABRIC_PT1}-{FABRIC_PT2}-{OTHER_OPTIONS}
  e.g. MXWL.FABRIC.SOFA.STNDRD-ROY-005-DEPTH-40-Leg001-3-LENGTH-90
  color = first two hyphen tokens after base SKU  → ROY-005
  legs  = token containing "Leg" + the next token → Leg001-3 (upcased → LEG001-3)
{% endcomment %}
{% assign sku_parts    = sku | split: "." %}
{% assign col          = sku_parts[0] %}
{% assign options_str  = variant | remove_first: sku | remove_first: "-" %}
{% assign option_parts = options_str | split: "-" %}
{% assign color        = option_parts[0] | append: "-" | append: option_parts[1] %}

{% assign legs = "" %}
{% for i in (0..15) %}
  {% assign _part = option_parts[i] %}
  {% if _part contains "Leg" and legs == "" %}
    {% assign _next = i | plus: 1 %}
    {% assign legs = _part | append: "-" | append: option_parts[_next] | upcase %}
  {% endif %}
{% endfor %}
{% if legs == "" %}{% assign legs = "LEG001-1" %}{% endif %}

{% comment %}3-part fabric codes: OTE-SURREY-2, AK-618-xx, I-73338-xx — append the third token{% endcomment %}
{% if option_parts[0] == "OTE" or option_parts[0] == "AK" or option_parts[0] == "I" %}
  {% assign color = option_parts[0] | append: "-" | append: option_parts[1] | append: "-" | append: option_parts[2] %}
{% endif %}

{% if col == "MXWL" %}

  {% comment %}--- Slot 2: Slipcovered — fixed showcase CAS-016 (Ivory Canvas) ---{% endcomment %}
  {% comment %}
    Standard Maxwell fabric codes are not available on the Slipcovered product.
    Always display CAS-016 regardless of buyer's sofa fabric.
  {% endcomment %}
  {% assign slpcov_fabric = "CAS-016" %}

  {% comment %}--- Slot 2: Slipcovered leg fallback → LEG016-1 ---{% endcomment %}
  {% comment %}
    Only Leg016-x option value IDs are confirmed in catalog (from WEB_PAGES).
    Leg014-x and Leg001-x fall back to LEG016-1 (most common Slipcov leg, 56% of orders).
  {% endcomment %}
  {% if legs == "LEG016-1" or legs == "LEG016-2" or legs == "LEG016-3" %}
    {% assign slpcov_leg = legs %}
  {% else %}
    {% assign slpcov_leg = "LEG016-1" %}
  {% endif %}

  {% comment %}--- Slot 3: Leather — always 2210A (Palomino, #1 by orders); Leg002-3 not on Maxwell Leather → LEG002-4 ---{% endcomment %}
  {% if legs == "LEG002-3" %}
    {% assign leather_leg = "LEG002-4" %}
  {% else %}
    {% assign leather_leg = legs %}
  {% endif %}

  {% comment %}--- Slot 4: Ottoman fabric fallback → Limestone (MER-002) ---{% endcomment %}
  {% comment %}
    Not available on Ottoman: ANG-003, OMNI-016
  {% endcomment %}
  {% if color == "ANG-003" or color == "OMNI-016" %}
    {% assign otto_fabric = "MER-002" %}
  {% else %}
    {% assign otto_fabric = color %}
  {% endif %}

  {% comment %}--- Cylindo image URLs ---{% endcomment %}
  {% assign _cyl = "https://content.cylindo.com/api/v2/4472/products/" %}

  {% assign img_tall = _cyl
    | append: "MXWL.FABRIC.SOFA.STNDRD.TALL/frames/1/MXWL.FABRIC.SOFA.STNDRD.TALL.png"
    | append: "?background=FFFFFF"
    | append: "&feature=COLOR:" | append: color
    | append: "&feature=CUSHIONS:CUSHION-2"
    | append: "&feature=FINISH:" | append: legs %}

  {% assign img_slpcov = _cyl
    | append: "MXWL.SLPCOV.SOFA.STNDRD/frames/1/MXWL.SLPCOV.SOFA.STNDRD.png"
    | append: "?background=FFFFFF"
    | append: "&feature=COLOR:CAS-016"
    | append: "&feature=FINISH:" | append: slpcov_leg %}

  {% assign img_leather = _cyl
    | append: "MXWL.LEATHR.SOFA.STNDRD/frames/1/MXWL.LEATHR.SOFA.STNDRD.png"
    | append: "?background=FFFFFF"
    | append: "&feature=COLOR:2210A"
    | append: "&feature=CUSHIONS:CUSHION-2"
    | append: "&feature=FINISH:" | append: leather_leg %}

  {% assign img_ottoman = _cyl
    | append: "MXWL.FABRIC.OTTO.STNDRD/frames/1/MXWL.FABRIC.OTTO.STNDRD.png"
    | append: "?background=FFFFFF"
    | append: "&feature=COLOR:" | append: otto_fabric
    | append: "&feature=FINISH:" | append: legs %}

  {% comment %}--- PDP links — catalog-driven, pre-selects buyer's fabric + leg ---{% endcomment %}

  {% comment %}Tall (buyer's fabric + leg; limited catalog coverage → mostly base_url){% endcomment %}
  {% catalog_items product_config MXWL_TALL %}{% assign _tall_prod = catalog_items[0] %}
  {% catalog_items fabric_ids {{ "MXWL_TALL_" | append: color }} %}{% assign _tall_fab = catalog_items[0] %}
  {% catalog_items leg_ids {{ "MXWL_TALL_" | append: legs }} %}{% assign _tall_leg = catalog_items[0] %}
  {% if _tall_fab.material_type_id and _tall_leg.legs_type_id %}
    {% assign url_tall = _tall_prod.base_url
      | append: "?legs-type=" | append: _tall_leg.legs_type_id
      | append: "&material-type=" | append: _tall_fab.material_type_id
      | append: "&options-" | append: _tall_prod.fabric_attr_id | append: "=" | append: _tall_fab.material_type_id
      | append: "&options-" | append: _tall_prod.leg_attr_id | append: "=" | append: _tall_leg.legs_type_id
      | append: "&" | append: _tall_prod.fixed_params %}
  {% else %}
    {% assign url_tall = _tall_prod.base_url %}
  {% endif %}

  {% comment %}Slipcovered (fixed CAS-016 showcase; buyer's Leg016-x or fallback LEG016-1){% endcomment %}
  {% catalog_items product_config MXWL_SLPCOV %}{% assign _slpcov_prod = catalog_items[0] %}
  {% catalog_items fabric_ids MXWL_SLPCOV_CAS-016 %}{% assign _slpcov_fab = catalog_items[0] %}
  {% catalog_items leg_ids {{ "MXWL_SLPCOV_" | append: slpcov_leg }} %}{% assign _slpcov_leg = catalog_items[0] %}
  {% if _slpcov_fab.material_type_id and _slpcov_leg.legs_type_id %}
    {% assign url_slpcov = _slpcov_prod.base_url
      | append: "?legs-type=" | append: _slpcov_leg.legs_type_id
      | append: "&material-type=" | append: _slpcov_fab.material_type_id
      | append: "&options-" | append: _slpcov_prod.fabric_attr_id | append: "=" | append: _slpcov_fab.material_type_id
      | append: "&options-" | append: _slpcov_prod.leg_attr_id | append: "=" | append: _slpcov_leg.legs_type_id
      | append: "&" | append: _slpcov_prod.fixed_params %}
  {% else %}
    {% assign url_slpcov = _slpcov_prod.base_url %}
  {% endif %}

  {% comment %}Leather (always 8519A showcase; buyer's leg with Leg002-3 → Leg002-4 fallback){% endcomment %}
  {% catalog_items product_config MXWL_LEATHR %}{% assign _leathr_prod = catalog_items[0] %}
  {% catalog_items fabric_ids MXWL_LEATHR_2210A %}{% assign _leathr_fab = catalog_items[0] %}
  {% catalog_items leg_ids {{ "MXWL_LEATHR_" | append: leather_leg }} %}{% assign _leathr_leg = catalog_items[0] %}
  {% if _leathr_fab.material_type_id and _leathr_leg.legs_type_id %}
    {% assign url_leather = _leathr_prod.base_url
      | append: "?legs-type=" | append: _leathr_leg.legs_type_id
      | append: "&material-type=" | append: _leathr_fab.material_type_id
      | append: "&options-" | append: _leathr_prod.fabric_attr_id | append: "=" | append: _leathr_fab.material_type_id
      | append: "&options-" | append: _leathr_prod.leg_attr_id | append: "=" | append: _leathr_leg.legs_type_id
      | append: "&" | append: _leathr_prod.fixed_params %}
  {% else %}
    {% assign url_leather = _leathr_prod.base_url %}
  {% endif %}

  {% comment %}Ottoman (buyer's fabric with ANG-003/OMNI-016 fallback; full leg coverage){% endcomment %}
  {% catalog_items product_config MXWL_OTTO %}{% assign _otto_prod = catalog_items[0] %}
  {% catalog_items fabric_ids {{ "MXWL_OTTO_" | append: otto_fabric }} %}{% assign _otto_fab = catalog_items[0] %}
  {% catalog_items leg_ids {{ "MXWL_OTTO_" | append: legs }} %}{% assign _otto_leg = catalog_items[0] %}
  {% if _otto_fab.material_type_id and _otto_leg.legs_type_id %}
    {% assign url_ottoman = _otto_prod.base_url
      | append: "?legs-type=" | append: _otto_leg.legs_type_id
      | append: "&material-type=" | append: _otto_fab.material_type_id
      | append: "&options-" | append: _otto_prod.fabric_attr_id | append: "=" | append: _otto_fab.material_type_id
      | append: "&options-" | append: _otto_prod.leg_attr_id | append: "=" | append: _otto_leg.legs_type_id
      | append: "&" | append: _otto_prod.fixed_params %}
  {% else %}
    {% assign url_ottoman = _otto_prod.base_url %}
  {% endif %}

{% endif %}

<!-- =====================================================================
     HTML LAYOUT — paste below into the email template after the block above
     Uses: img_tall, img_slpcov, img_leather, img_ottoman
           url_tall, url_slpcov, url_leather, url_ottoman
     Only renders when col == "MXWL"
     ===================================================================== -->

{% if col == "MXWL" %}
<table width="600" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial,sans-serif;font-size:14px;color:#101b24;">
  <tr>
    <td style="padding:24px 0 8px 0;text-align:center;font-size:18px;font-weight:bold;letter-spacing:0.02em;">
      Complete Your Maxwell Collection
    </td>
  </tr>
  <!-- Row 1: Tall + Slipcovered -->
  <tr>
    <td style="padding:0 0 12px 0;">
      <table width="600" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <!-- Slot 1: Tall -->
          <td width="294" style="padding-right:6px;vertical-align:top;text-align:center;">
            <a href="{{ url_tall }}" style="display:block;">
              <img src="{{ img_tall }}" width="294" alt="Maxwell Tall Sofa" style="display:block;width:100%;border:0;" />
            </a>
            <p style="margin:6px 0 0 0;font-size:13px;color:#101b24;">Maxwell Tall</p>
            <a href="{{ url_tall }}" style="font-size:12px;color:#1871D8;text-decoration:underline;">Shop Now</a>
          </td>
          <!-- Slot 2: Slipcovered -->
          <td width="294" style="padding-left:6px;vertical-align:top;text-align:center;">
            <a href="{{ url_slpcov }}" style="display:block;">
              <img src="{{ img_slpcov }}" width="294" alt="Maxwell Slipcovered Sofa" style="display:block;width:100%;border:0;" />
            </a>
            <p style="margin:6px 0 0 0;font-size:13px;color:#101b24;">Maxwell Slipcovered</p>
            <a href="{{ url_slpcov }}" style="font-size:12px;color:#1871D8;text-decoration:underline;">Shop Now</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <!-- Row 2: Leather + Ottoman -->
  <tr>
    <td style="padding:0 0 24px 0;">
      <table width="600" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <!-- Slot 3: Leather -->
          <td width="294" style="padding-right:6px;vertical-align:top;text-align:center;">
            <a href="{{ url_leather }}" style="display:block;">
              <img src="{{ img_leather }}" width="294" alt="Maxwell Leather Sofa" style="display:block;width:100%;border:0;" />
            </a>
            <p style="margin:6px 0 0 0;font-size:13px;color:#101b24;">Maxwell Leather Sofa</p>
            <a href="{{ url_leather }}" style="font-size:12px;color:#1871D8;text-decoration:underline;">Shop Now</a>
          </td>
          <!-- Slot 4: Ottoman -->
          <td width="294" style="padding-left:6px;vertical-align:top;text-align:center;">
            <a href="{{ url_ottoman }}" style="display:block;">
              <img src="{{ img_ottoman }}" width="294" alt="Maxwell Ottoman" style="display:block;width:100%;border:0;" />
            </a>
            <p style="margin:6px 0 0 0;font-size:13px;color:#101b24;">Maxwell Ottoman</p>
            <a href="{{ url_ottoman }}" style="font-size:12px;color:#1871D8;text-decoration:underline;">Shop Now</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
{% endif %}
